    // --- TRANSPOSE CHORDS ENGINE ---
    function transposeMobileChords(semitones) {
      currentTransposeStep += semitones;
      const pitches = ['Am', 'A#m', 'Bm', 'Cm', 'C#m', 'Dm', 'D#m', 'Em', 'Fm', 'F#m', 'Gm', 'G#m'];
      let idx = (9 + currentTransposeStep) % 12;
      if (idx < 0) idx += 12;
      document.getElementById('mobilePitchBadge').innerText = pitches[idx];

      const lines = document.querySelectorAll('.mobile-chord-line');
      lines.forEach(el => {
        el.innerText = el.innerText.replace(/[A-G][#b]?m?/g, m => {
          const notes = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
          const isMinor = m.includes('m');
          const root = m.replace('m', '').replace('b', '#');
          let nIdx = notes.indexOf(root);
          if (nIdx === -1) return m;
          let newIdx = (nIdx + semitones) % 12;
          if (newIdx < 0) newIdx += 12;
          return notes[newIdx] + (isMinor ? 'm' : '');
        });
      });

      showToast(`Akorlar ${semitones > 0 ? '+1' : '-1'} Ton Dönüştürüldü (${pitches[idx]})`);
    }

