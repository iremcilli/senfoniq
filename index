      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .dark ::-webkit-scrollbar-thumb {
      background: #334155;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Pixel Art Rendering */
    .pixelated {
      image-rendering: pixelated;
      image-rendering: -moz-crisp-edges;
      image-rendering: crisp-edges;
    }

    /* Subtle Glass Navigation */
    .glass-nav-light {
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    .dark .glass-nav-light {
      background: rgba(16, 14, 24, 0.94);
    }

    /* Phone Mockup Frame (Desktop) */
    .mobile-phone-frame {
      width: 100%;
      max-width: 420px;
      height: 870px;
      border-radius: 48px;
      border: 10px solid #e2e8f0;
      box-shadow: 
        0 0 0 2px #cbd5e1,
        0 25px 60px -15px rgba(15, 23, 42, 0.18),
        0 0 40px rgba(124, 58, 237, 0.08);
      position: relative;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .dark .mobile-phone-frame {
      border: 10px solid #28243a;
      box-shadow: 
        0 0 0 2px #1c1929,
        0 30px 70px -15px rgba(0, 0, 0, 0.9),
        0 0 40px rgba(124, 58, 237, 0.15);
    }

    /* Fullscreen Mode (When user switches or mobile native) */
    .mobile-phone-fullscreen {
      max-width: 100% !important;
      height: 100vh !important;
      border-radius: 0 !important;
      border: none !important;
      box-shadow: none !important;
    }

    /* Dynamic Island Simulator */
    .dynamic-island {
      width: 110px;
      height: 24px;
      background: #0f172a;
      border-radius: 20px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .dynamic-island:hover {
      width: 180px;
    }

    /* Animated Soundwave */
    @keyframes barPulse {
      0%, 100% { height: 4px; }
      50% { height: 18px; }
    }
    .wave-bar {
      animation: barPulse 1s infinite ease-in-out;
    }
    .wave-bar:nth-child(2) { animation-delay: 0.2s; }
    .wave-bar:nth-child(3) { animation-delay: 0.4s; }
    .wave-bar:nth-child(4) { animation-delay: 0.1s; }
    .wave-bar:nth-child(5) { animation-delay: 0.3s; }

    input[type=range] {
      accent-color: #7c3aed;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
