    // --- CANVAS WAVEFORMS ---
    function drawMobileCanvasWaveforms() {
      ['guitar', 'bass', 'drums'].forEach(track => {
        const c = document.getElementById(`mobCanvas-${track}`);
        if (!c) return;
        const ctx = c.getContext('2d');
        ctx.clearRect(0, 0, c.width, c.height);
        const bars = 24;
        const w = c.width / bars;
        ctx.fillStyle = track === 'guitar' ? '#f7f8c0' : (track === 'bass' ? '#7c3aed' : '#10b981');
        for (let i = 0; i < bars; i++) {
          const h = Math.random() * (c.height * 0.75) + 3;
          ctx.fillRect(i * w, (c.height - h) / 2, w - 1.5, h);
        }
      });
    }

    function drawRecordedVocalCanvas() {
      const c = document.getElementById('mobCanvas-vocal');
      if (!c) return;
      const ctx = c.getContext('2d');
      ctx.clearRect(0, 0, c.width, c.height);
      const bars = 24;
      const w = c.width / bars;
      ctx.fillStyle = '#f43f5e';
      for (let i = 0; i < bars; i++) {
        const h = Math.sin(i * 0.3) * (c.height * 0.4) + (c.height * 0.4) + 2;
        ctx.fillRect(i * w, (c.height - h) / 2, w - 1.5, h);
      }
    }

