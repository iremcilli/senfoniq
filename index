      } else {
        // Switch to Dark Mode
        html.classList.remove('light');
        html.classList.add('dark');
        currentTheme = 'dark';
        document.getElementById('themeDesktopIcon').className = "fa-solid fa-moon text-purple-400";
        document.getElementById('themeDesktopText').innerText = "Koyu Mod (Aktif)";
        document.getElementById('themeMobileIcon').className = "fa-solid fa-moon";
        showToast("🌙 Koyu Mod (Dark Mode) Aktifleştirildi");
      }
    }

    // --- AUDIO CONTEXT INITIALIZER ---
    function getAudioContext() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    // Synthetic Audio Helpers
    function playSyntheticGuitar(freqs, duration = 1.4) {
      if (trackMutes.guitar) return;
      const ctx = getAudioContext();
      freqs.forEach((f, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(f, ctx.currentTime + idx * 0.02);
        const vol = trackVolumes.guitar * 0.12;
        gain.gain.setValueAtTime(vol, ctx.currentTime + idx * 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + idx * 0.02 + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime + idx * 0.02);
        osc.stop(ctx.currentTime + idx * 0.02 + duration);
      });
    }

    function playSyntheticBass(freq, duration = 0.6) {
      if (trackMutes.bass) return;
      const ctx = getAudioContext();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      const vol = trackVolumes.bass * 0.18;
      gain.gain.setValueAtTime(vol, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + duration);
    }

    function playSyntheticDrumBeat() {
      if (trackMutes.drums) return;
      const ctx = getAudioContext();
      // Kick drum simulation
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.frequency.setValueAtTime(150, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);
      gain.gain.setValueAtTime(trackVolumes.drums * 0.25, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.15);
    }

    function playSyntheticBeep(freq = 880, duration = 0.035) {
      try {
        const ctx = getAudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
      } catch (e) {}
    }

