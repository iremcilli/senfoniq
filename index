    // --- PUBLISH LAYER MODAL ---
    function openPublishLayerModal() {
      document.getElementById('publishLayerModal').classList.remove('hidden');
    }
    function closePublishLayerModal() {
      document.getElementById('publishLayerModal').classList.add('hidden');
    }
    function confirmPublishLayer() {
      const name = document.getElementById('pubLayerName').value;
      closePublishLayerModal();
      showToast(`'${name}' Katmanı Kolektif Yayına Alındı!`);
      switchTab('home');
    }

    // --- NEW PROJECT CALL MODAL ---
    function openNewProjectModal() {
      document.getElementById('newProjectModal').classList.remove('hidden');
    }
    function closeNewProjectModal() {
      document.getElementById('newProjectModal').classList.add('hidden');
    }
    function submitNewCall() {
      const title = document.getElementById('newCallTitle').value || 'Yeni Proje';
      const bpm = document.getElementById('newCallBpm').value || '120';
      const key = document.getElementById('newCallKey').value || 'Am';
      const needs = document.getElementById('newCallNeeds').value || 'Katman Aranıyor';
      closeNewProjectModal();

      // Prepend to mobilePostList
      const postList = document.getElementById('mobilePostList');
      if (postList) {
        const newCard = document.createElement('article');
        newCard.className = "bg-white dark:bg-brandDarkCard border-2 border-brandPurple/40 dark:border-brandDarkBorder rounded-2xl p-3.5 space-y-3 shadow-light-card transition-all";
        newCard.setAttribute('data-cat', 'original help');
        newCard.innerHTML = `
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
              <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-[#f7f8c0] to-purple-600 p-0.5 shadow-sm">
                <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100" class="w-full h-full object-cover rounded-full" alt="Barış">
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
                  Barış Yıldız <span class="text-[9px] bg-purple-100 dark:bg-purple-900/40 text-brandPurple px-1.5 py-0.2 rounded font-bold font-mono">SEN</span>
                  <span class="text-[10px] text-slate-400 font-normal">• Şimdi</span>
                </h4>
                <span class="text-[10px] text-brandPurple font-semibold">Elektro Gitar & Vokal</span>
              </div>
            </div>
            <span class="font-pixel text-[8px] bg-[#f7f8c0] text-slate-900 px-2 py-0.5 rounded-md font-bold">YENİ ÇAĞRI</span>
          </div>
          <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
            "${title}" projesini başlattım! Aranan katmanlar: ${needs}. Katılmak isteyen müzisyen dostları bekliyorum. 🎸✨
          </p>
          <div class="bg-slate-50 dark:bg-brandDark rounded-xl p-3 border border-slate-200/80 dark:border-brandDarkBorder flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
              <button onclick="playMobileSampleAudio('${title}', 'Barış Yıldız')" class="w-9 h-9 rounded-full bg-brandPurple text-white flex items-center justify-center shadow-sm">
                <i class="fa-solid fa-play text-xs ml-0.5"></i>
              </button>
              <div>
                <h5 class="text-xs font-bold text-slate-900 dark:text-white truncate max-w-[150px]">${title}</h5>
                <p class="text-[10px] text-slate-500 font-mono">${bpm} BPM • Ton: ${key}</p>
              </div>
            </div>
            <button onclick="loadSongToStudio('${title}', '${key}', ${bpm})" class="px-2.5 py-1 text-xs rounded-xl bg-white dark:bg-brandDarkCard text-brandPurple border border-purple-200 font-bold transition">
              Stüdyoya Al
            </button>
          </div>
          <div class="flex items-center justify-between text-xs text-slate-600 dark:text-slate-400 pt-0.5">
            <div class="flex items-center space-x-3">
              <button onclick="toggleCardLike(this)" class="hover:text-rose-500 flex items-center space-x-1"><i class="fa-regular fa-heart"></i> <span>1</span></button>
              <button onclick="openPostComments('${title}')" class="hover:text-brandPurple flex items-center space-x-1"><i class="fa-regular fa-comment"></i> <span>0</span></button>
              <button onclick="openForkModal('${title}', 'Barış Yıldız', 0, this)" class="hover:text-purple-600 flex items-center space-x-1"><i class="fa-solid fa-code-fork text-purple-500"></i> <span class="fork-count">0</span></button>
              <button onclick="shareProject('${title}')" class="hover:text-brandPurple flex items-center space-x-1"><i class="fa-solid fa-share-nodes"></i></button>
            </div>
            <span class="text-[10px] text-emerald-600 font-semibold">Yeni Başlatıldı</span>
          </div>
        `;
        postList.prepend(newCard);
        applyFeedFilters();
      }

      loadSongToStudio(title, key, bpm);
      showToast(`'${title}' Katman Çağrısı Yayınlandı!`);
    }

    // --- NOTIFICATION DRAWER ---
    function toggleNotificationDrawer() {
      const d = document.getElementById('notificationDrawer');
      d.classList.toggle('hidden');
    }

    // --- SPLIT SHEET MODAL ---
    function openSplitSheetModal() {
      document.getElementById('splitSheetModal').classList.remove('hidden');
    }
    function closeSplitSheetModal() {
      document.getElementById('splitSheetModal').classList.add('hidden');
    }

    // --- AUDIO FILE UPLOAD ---
    function triggerStudioAudioUpload() {
      document.getElementById('studioFileInput').click();
    }
    function handleStudioAudioUpload(event) {
      const file = event.target.files[0];
      if (file) {
        showToast(`'${file.name}' Ses Dosyası Stüdyoya Yüklendi!`);
      }
    }

    // --- LOAD SONG INTO STUDIO ---
    function loadSongToStudio(title, key, bpm) {
      document.getElementById('mobilePitchBadge').innerText = key;
      document.getElementById('mobBpmDisplay').innerText = `${bpm} BPM`;
      metronomeBpm = bpm;
      switchTab('create');
      showToast(`'${title}' Stüdyoya Yüklendi!`);
    }

    // --- DESKTOP FRAME CONTROLLER ---
    function togglePhoneFrame() {
      isPhoneFrame = !isPhoneFrame;
      const container = document.getElementById('phoneDeviceContainer');
      const text = document.getElementById('frameToggleText');

      if (isPhoneFrame) {
        container.classList.remove('mobile-phone-fullscreen');
        if (text) text.innerText = "Telefon Çerçevesi";
        showToast("Telefon Çerçevesi Modu");
      } else {
        container.classList.add('mobile-phone-fullscreen');
        if (text) text.innerText = "Tam Ekran";
        showToast("Tam Ekran Görünüm Modu");
      }
    }

    function setPhoneFrameColor(color) {
      document.getElementById('phoneDeviceContainer').style.borderColor = color;
      showToast("Kasa Rengi Güncellendi");
    }

    // --- TOAST NOTIFICATIONS ---
    function showToast(msg) {
      const toast = document.getElementById('toastBox');
      document.getElementById('toastMessage').innerText = msg;
      toast.classList.remove('translate-y-[-120px]', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-[-120px]', 'opacity-0');
      }, 2600);
    }

    // Clock Tick
    setInterval(() => {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const el = document.getElementById('phoneClock');
      if (el) el.innerText = `${h}:${m}`;
    }, 1000);

    // Initial render
    window.addEventListener('load', () => {
      drawMobileCanvasWaveforms();
    });
  </script>
</body>
</html>

